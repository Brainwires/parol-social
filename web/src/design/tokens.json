{
  "meta": {
    "name": "ParolNet design tokens",
    "note": "Single source for the web app (scripts/gen-tokens.ts writes tokens.css from it) and the GPUI desktop app. Lengths are CSS pixels, durations are milliseconds. See docs/ux/web-app.md."
  },
  "color": {
    "paper": { "light": "#F3F5F4", "dark": "#0F181D", "use": "Page ground" },
    "surface": {
      "light": "#FFFFFF",
      "dark": "#172229",
      "use": "Raised ground: sheets, fields, the composer"
    },
    "fog": { "light": "#E1E6E4", "dark": "#26343C", "use": "Lines and received bubbles" },
    "ink": {
      "light": "#15232D",
      "dark": "#E8EEEC",
      "use": "Text, delivered bubbles, primary buttons"
    },
    "ink-2": { "light": "#51606A", "dark": "#9DACB3", "use": "Secondary text" },
    "on-ink": { "light": "#F3F5F4", "dark": "#0F181D", "use": "Text on ink" },
    "open": { "light": "#0F7A5C", "dark": "#5FD0AC", "use": "State: the direct line is open" },
    "open-fill": { "light": "#D5EFE6", "dark": "#12382F", "use": "Ground behind an open state" },
    "lamp": { "light": "#8A5A00", "dark": "#F0BC55", "use": "State text: waiting or held" },
    "lamp-line": {
      "light": "#D9981E",
      "dark": "#D9981E",
      "use": "State line: waiting or held; the focus ring"
    },
    "lamp-fill": { "light": "#FBEFD3", "dark": "#3A2E12", "use": "Ground behind a waiting state" },
    "flare": {
      "light": "#B3261E",
      "dark": "#FF8A80",
      "use": "State: blocked for safety, or destructive"
    },
    "flare-fill": { "light": "#F9DEDB", "dark": "#44201D", "use": "Ground behind a blocked state" },
    "video-ground": { "light": "#0B1216", "dark": "#05090B", "use": "Behind video" }
  },
  "font": {
    "text": ["Atkinson Hyperlegible Next", "Vazirmatn", "system-ui", "sans-serif"],
    "mono": ["Atkinson Hyperlegible Mono", "ui-monospace", "monospace"],
    "weight": { "regular": 400, "medium": 500, "bold": 700 }
  },
  "type": {
    "ratio": 1.2,
    "size": { "caption": 14, "body": 17, "lead": 20, "title": 24, "display": 29 },
    "line": { "tight": 1.2, "text": 1.45 }
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32, "7": 48 },
  "radius": { "control": 10, "bubble": 14, "bubble-tail": 4, "panel": 12, "full": 9999 },
  "border": { "hairline": 1, "state": 1.5 },
  "focus": { "width": 3, "offset": 2, "color": "lamp-line" },
  "target": { "min": 44 },
  "layout": { "list-width": 360, "split-min": 900, "measure": 680 },
  "motion": { "fill-stagger": 350, "fill-duration": 450 }
}
