{
  "tasks": {
    "wasm": "wasm-pack build ../../../crates/parolnet-wasm --target web --release --out-dir ../../web/tests/engine/.pkg",
    "test": "deno test --allow-read=.,../../../specs --allow-env=PAROLNET_WASM_PKG .",
    "check": "deno check ../../src/engine/*.ts *.ts harness/*.ts e2e/*.ts",
    "lint": "deno lint ../../src/engine .",
    "fmt": "deno fmt --line-width 100 ../../src/engine .",
    "fmt:check": "deno fmt --check --line-width 100 ../../src/engine .",
    "e2e:build": "deno run --allow-read --allow-write --allow-run --allow-env e2e/build.ts",
    "e2e": "node e2e/run.mjs"
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.window", "dom", "dom.iterable"]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.0"
  },
  "fmt": {
    "lineWidth": 100,
    "exclude": [".pkg/", "e2e/dist/"]
  },
  "lint": {
    "exclude": [".pkg/", "e2e/dist/"]
  },
  "exclude": [".pkg/", "e2e/dist/", "e2e/work/"]
}
