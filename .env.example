# ParolNet Environment Configuration
# Copy to .env and fill in values. Docker Compose loads this automatically.

# Relay profile (PNP-001 §10.5). Default: signaling-only — the relay only
# helps peers set up direct connections and never relays or stores user
# content. Set to 0 to offer the relay profile (mailbox, Privacy Pass tokens,
# onion cells, gossip, TURN credentials, federation).
# SIGNALING_ONLY=1

# STUN URIs served by /turn-credentials (comma-separated, stun:/stuns: only).
# STUN_URIS=stun:stun.your-domain.com:3478

# Real client addresses: nginx in the image forwards CF-Connecting-IP (or the
# socket address) as X-Forwarded-For, trusted only from these proxies.
# TRUSTED_PROXY_IPS=127.0.0.1

# Analytics (1 = enabled, 0 = disabled; relay profile only)
PAROLNET_ANALYTICS=0

# TURN (relay profile only; the image runs no TURN server). Run your own TURN
# server with a REST shared secret and point the relay at it:
# TURN_SECRET=your-shared-secret-here
# TURN_URIS=turn:turn.your-domain.com:3478,turns:turn.your-domain.com:5349
