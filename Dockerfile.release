# Reproducible build environment for ParolNet
# Usage: docker build -f Dockerfile.release -t parolnet-build .
#        docker run --rm -v $(pwd)/dist:/out parolnet-build

FROM rust:1.92-bookworm AS builder

# Pin wasm-pack version for deterministic WASM output
ENV WASM_PACK_VERSION=0.13.1

# Install pinned wasm-pack
RUN cargo install wasm-pack --version ${WASM_PACK_VERSION} --locked

# Denext, for the web app's export (web/): the version web/deno.lock resolves, and the runtime
# release that version bundles (`denext runtime install`), as in the Dockerfile.
ENV DENEXT_VERSION=v4.21.0 \
    DENEXT_INSTALL=/opt/denext \
    DENO_DIR=/opt/deno-cache \
    PATH=/opt/denext/bin:$PATH
RUN curl -fsSL https://denext.dev/install.sh \
      | DENEXT_NO_RUNTIME=1 DENEXT_MODIFY_PATH=0 sh \
    && denext runtime install

# Copy workspace
WORKDIR /build
COPY . .

# Ensure lockfile is used (no network dependency resolution)
# Build relay server
RUN cargo build --release --locked --bin parolnet-relay

# Build authority CLI
RUN cargo build --release --locked --bin parolnet-authority

# Build the web app: the wasm core (wasm-pack, into web/.wasm-pkg and, content-hashed,
# web/public/wasm), then the production export in web/out. This is what the relay image serves
# at /pwa/.
RUN cd web \
    && denext deno install --frozen \
    && denext task build-wasm \
    && denext task build

# Generate checksums
RUN mkdir -p /artifacts && \
    cp target/release/parolnet-relay /artifacts/ && \
    cp target/release/parolnet-authority /artifacts/ && \
    cp -r web/.wasm-pkg /artifacts/wasm-pkg && \
    cp -r web/out /artifacts/web && \
    cd /artifacts && \
    sha256sum parolnet-relay > SHA256SUMS && \
    sha256sum parolnet-authority >> SHA256SUMS && \
    find wasm-pkg -type f -name '*.wasm' -o -name '*.js' | sort | xargs sha256sum >> SHA256SUMS && \
    find web -type f | sort | xargs sha256sum >> SHA256SUMS

# Output stage - copy artifacts
FROM scratch AS artifacts
COPY --from=builder /artifacts /

# Default: copy artifacts to /out volume
FROM debian:bookworm-slim AS export
COPY --from=builder /artifacts /artifacts
CMD ["sh", "-c", "cp -r /artifacts/* /out/ && echo 'Artifacts copied to /out/' && cat /out/SHA256SUMS"]
